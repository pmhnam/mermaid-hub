# Use URL-safe values for POSTGRES_PASSWORD because it is part of DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
JWT_ACCESS_SECRET=replace-with-a-separate-random-hex-secret-at-least-32-characters
PUBLIC_LINK_SECRET=replace-with-another-random-hex-secret-at-least-32-characters

# Optional Google sign-in: configure all four to enable the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APP_URL=

# Optional OpenAI-compatible chat completions endpoint (including /v1 if required).
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
